 250 |       setUpdateActionInFlight(null);
 251 |       return;
 252 |     }
 253 | 
 254 |     // 退出准备和 Windows 安装器交接可能超过 5 秒；旧的统一 ACK 定时器会在
 255 |     // 应用真正退出前恢复“重启以更新”，让用户误判失败并重复点击。restart 成功路径保持
